<%args>
	$round
	$default => undef
</%args>
<%init>

	$m->abort unless $round;
	my $round_id = $round->id;

	my $dbh = Tab::DBI->db_Main();

	my $sth = $dbh->prepare("
		select
			round.id, round.published, round.label, round.name, round.type,
			(select use_for_breakout.value
				from round_setting use_for_breakout
				where use_for_breakout.tag = 'use_for_breakout'
				and use_for_breakout.value = 1
				and use_for_breakout.round = round.id
			) as use_for_breakout
		from round
			where round.event = ?
		order by use_for_breakout, round.name
	");

	$sth->execute($round->event);
	my $rounds = $sth->fetchall_hash();

	my $event = $round->event;
	my $event_type = $event->type;
	my $event_name = quotemeta $event->name;
	my $event_abbr = quotemeta $event->abbr;

	my $breakout;

</%init>
		<ul id="tabnav">
<%perl>

		foreach my $allround (@{$rounds}) {

			my $extra_class;

			if ($breakout ne $allround->{use_for_breakout}) {
			 	$breakout = $allround->{use_for_breakout};
				$extra_class = "marleftmuchmore";
			}

			my $unbalanced;
			if ($event_type eq "speech" || $event_type eq "congress") {
				$unbalanced = $m->comp("/funclib/round_unbalanced.mas", round => $allround->{id});
			}

			my $realname = $allround->{label} || "Round ".$allround->{name};

			$realname =~ s/$event_name//g;
			$realname =~ s/$event_abbr//g;
			$realname =~ s/Round\ /Rd/g;
			$realname =~ s/Session\ /Sess/g;
			$realname =~ s/Doubles/Dbl/g;
			$realname =~ s/Double /Dbl/g;
			$realname =~ s/\s//g;

			my $test = $realname;
			eval { $test = $test + 0; };
			$realname = "R".$realname if $test;
			$realname = substr($realname, 0, 5);
			$realname = "Runoff" if $realname eq "Runof";
</%perl>

			<li class="<% $extra_class %> <% ($allround->{id} == $round_id) ? "selected" : "" %>
				<% $unbalanced ?  "warning" : "" %>"
			>
				<a
					href="show.mhtml?round_id=<% $allround->{id} %>"
				><% $realname %></a>
			</li>
%		}

		</ul>

