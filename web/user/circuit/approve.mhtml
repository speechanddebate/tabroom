<%args>
	$dbh
	$tourn_id
	$person
	$circuit_id => undef
</%args>
<%init>

	my $tourn = Tab::Tourn->retrieve($tourn_id);
	my $circuit = Tab::Circuit->retrieve($circuit_id);

	unless ($person->site_admin) {

		my $sth = $dbh->prepare("
			select permission.id
			from permission
			where circuit = ?
			and person = ?
		");

		$sth->execute($circuit->id, $person->id);
		my $perms = $sth->fetchall_hash();

		unless ((scalar @{$perms}) > 0) {
			$m->comp("/funclib/abort.mas", message => "I call shenanigans. You do not have permission to approve tournaments in that circuit.");
		}
	}

	my $update_sth = $dbh->prepare("
		update tourn_circuit tc set tc.approved = 1 where tc.tourn = ? and tc.circuit = ?
	");

	$update_sth->execute($tourn->id, $circuit->id);

	my $msg = "Tournament ID ".$tourn->id." ".$tourn->name." has been approved with webname ".$tourn->webname;

	Tab::ChangeLog->create({
		person      => $person,
		tag         => 'circuit',
		description => $msg,
		circuit     => $circuit->id
	});

	$m->redirect("approvals.mhtml?circuit_id=".$circuit_id."&msg=".$msg) if $circuit_id;
	$m->redirect("approvals.mhtml?msg=".$msg) if $person->site_admin;

</%init>
