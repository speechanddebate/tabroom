<%args>
	$dbh
	$circuit_id
	$tourn
	$tourn_settings
	$person
	$person_settings
</%args>
<%init>

	my $circuit = Tab::Circuit->retrieve($circuit_id)
		if $circuit_id;

	unless ($circuit) {
		$m->redirect("/register/index.mhtml");
	}

	my $sth = $dbh->prepare("
		select
			cl.id, cl.tag, cl.description,
			person.id, person.email, person.first, person.last,
			cl.created_at, cl.timestamp

		from change_log cl
			left join person on person.id = cl.person

		where 1=1
			and cl.circuit = ?
		order by cl.timestamp DESC
	");

	$sth->execute($circuit->id);
	my $changes = $sth->fetchall_hash();

	my $tz = $circuit->tz;
	$tz = "UTC" unless $tz;

</%init>

	<& menu.mas,
		circuit => $circuit,
		whoami  => "log"
	&>

	<div class="main">

	<div class="full flexrow martopmore">
		<span class="fourfifths">
			<h4 class="nospace"><% $circuit->abbr %> Circuit Changelog</h4>
		</span>

		<span
			class="fifth rightalign bigger semibold"
			id    = "hijinks_buttonarea"
		> </span>
	</div>

	<& /funclib/tablesorter.mas, table => "hijinks" &>

	<table id="hijinks">

		<thead>

		<tr class="yellowrow">

			<th class="smaller">
				Who
			</th>

			<th class="smaller">
				What
			</th>

			<th class="smaller">
				When
			</th>

		</tr>
		</thead>

		<tbody>

<%perl>

 		foreach my $change (@{$changes}) {

			$change->{description} =~ s/,/, /g;
</%perl>
			<tr id="<% $change->{id} %>">

				<td class="smallish" title="<% $change->{email} %>">
					<% $change->{first}." ".$change->{last} %>
				</td>

				<td class="smallish">
					<% $change->{description} %>
				</th>

				<td class="smallish centeralign nowrap">
					<& "/funclib/showdt.mas",
						string => $change->{created_at} || $change->{timestamp},
						tz     => $tz,
						format => 'medium',
						at     => 1,
						tzname => 1
					&>
				</td>
			</tr>
%		}

		</tbody>

	</table>

	</div>


