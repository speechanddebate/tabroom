<%args>
	$person
	$person_settings
	$session
	$dbh
	$now
	$year => undef
	$mode => undef
</%args>
<%init>

	if ($now->day_of_week > 4) {
		if (
			($now->day_of_week == 5 && $now->hour > 17)
			|| $now->day_of_week > 5
		) {
			$m->comp("/funclib/abort.mas",
				message => "This report is resource intensive and therefore cannot be run during peak tournament hours (Friday afternoon through Sunday)"
			);
		}
	}

	unless ($year) {
		$year = Tab::school_year();
	}

	my $start = $year->year.'-08-01 00:00:00';
	my $end   = ($year->year + 1).'-08-01 00:00:00';

	if ($mode eq "schools") {

		my $filename = $year->year."-TabroomSchoolParticipation.csv";
		$m->clear_buffer;
		$r->content_type('application/csv');
		$r->headers_out->{'Content-Disposition'} = "attachment; filename=$filename";

		my $school_sth = $dbh->prepare("
			SELECT
				C.name,
				C.city,
				C.state,
				C.country,
				C.nsda,
				C.level,
				COUNT(DISTINCT ES.student) AS 'students',
				GROUP_CONCAT(DISTINCT(T.name) SEPARATOR ', ') AS 'tournaments',
				GROUP_CONCAT(DISTINCT(V.type) SEPARATOR ', ') AS 'events'
			FROM chapter C
				INNER JOIN school S ON S.chapter = C.id
				INNER JOIN tourn T ON T.id = S.tourn
				LEFT JOIN entry E ON E.tourn = T.id AND E.school = S.id
				LEFT JOIN entry_student ES ON ES.entry = E.id
				LEFT JOIN event V ON V.id = E.event AND V.tourn = T.id
			WHERE
				C.level <> 'university'
				AND T.start >= ?
				AND T.start <= ?
				AND T.hidden = 0
			GROUP BY C.id
			ORDER BY C.state, C.name
		");

		$school_sth->execute($start, $end);
		my $schools = $school_sth->fetchall_hash();

		$m->print("Name,City,State,Country,NSDA ID, Level, Students, Tournaments, Events\n");

		foreach my $ref (@{$schools}) {

			foreach my $tag (
				"name", "city", "state", "country",
				"nsda", "level", "students", "tournaments", "events"
			) {
				$m->print('"');
				$m->print($ref->{$tag});
				$m->print('",');
			}
			$m->print("\n");
		}

		$m->abort();
	}

	if ($mode eq "students") {

		my $filename = $year->year."-TabroomStudentParticipation.csv";
		$m->clear_buffer;
		$r->content_type('application/csv');
		$r->headers_out->{'Content-Disposition'} = "attachment; filename=$filename";

		my $student_sth = $dbh->prepare("
			SELECT
				ST.first,
				ST.last,
				ST.nsda,
				C.name,
				C.city,
				C.state,
				C.country,
				C.nsda school_nsda,
				C.level,
				count(distinct T.id) as 'num_tournaments',
				group_concat(distinct T.name) as 'tournaments',
				group_concat(distinct V.type) as 'events'
			FROM student ST
				INNER JOIN chapter C ON C.id = ST.chapter
				INNER JOIN school S ON S.chapter = C.id
				INNER JOIN tourn T ON T.id = S.tourn
				INNER JOIN entry E ON E.tourn = T.id AND E.school = S.id
				INNER JOIN entry_student ES ON ES.entry = E.id AND ES.student = ST.id
				INNER JOIN event V ON V.id = E.event AND V.tourn = T.id
			WHERE
				C.level <> 'university'
				AND T.start >= ?
				AND T.start <= ?
				AND T.hidden = 0
			GROUP BY ST.id
			ORDER BY C.state, C.name
		");

		$student_sth->execute($start, $end);
		my $students = $student_sth->fetchall_hash();

		$m->print("First,Last,NSDA,Name,City,State,Country,School NSDA, Level, Num Tourns, Tourns, Events\n");

		foreach my $ref (@{$students}) {

			foreach my $tag (
				"first", "last", "nsda", "name", "city", "state", "country",
				"school_nsda", "level", "num_tournaments", "tournaments", "events"
			) {
				$m->print('"');
				$m->print($ref->{$tag});
				$m->print('",');
			}
			$m->print("\n");
		}

		$m->abort();
	}

</%init>

	<& ../menu.mas,
		person          => $person,
		person_settings => $person_settings,
		whoami          => "participation"
	&>

	<& "/funclib/editor.mas" &>

