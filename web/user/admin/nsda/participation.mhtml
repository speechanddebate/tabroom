		<div class="full flexrow ltborderbottom">
			<span class='twothirds'>
				<h4>Tabroom Participation</h4>
			</span>
			<span class='third flexrow'>
				<span class='twothirds semibold rightalign'>
					School year starting
				</span>
				<span class='third padright rightalign'>
					<form action="participation.mhtml" method="post">
						<input
							type   = "number"
							name   = "year"
							value  = "<% $year %>"
							onBlur = 'this.form.submit();'
						>
					</form>
				</span>
			</span>
		</div>

		<div class="full flexrow centeralign">

			<span class="half centeralign padtopmore">
				<a
					class ="greenhover padlotsmore"
					href  ="participation.mhtml?mode=schools"
				>
					<div
						class="fa-2x fa fa-file-excel-o buttonwhite greentext padmore invert noborder"
					></div>

					<div class="full greentext biggish semibold">
						Schools
					</div>
				</a>
			</span>

			<span class="half centeralign padtopmore">
				<a
					class ="greenhover padlotsmore"
					href="participation.mhtml?mode=students"
				>
					<div
						class="fa-2x fa fa-file-excel-o buttonwhite greentext padmore invert noborder"
					></div>

					<div class="full greentext biggish semibold">
					Students
					</div>
				</a>
			</span>

		</div>
	</div>

