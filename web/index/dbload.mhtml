<%flags>
#	inherit => undef
</%flags>
<%init>

	my $timestamp;

	open (my $fh, "<", "/www/tabroom/web/lib/nodb");

	if ($fh) {
		my $epoch_timestamp = (stat($fh))[9];
		$timestamp          = localtime($epoch_timestamp);
	}

</%init>

<html>

	<head>
		<title>Database Refresh</title>
	</head>

	<body>
		<div class="blankfull">
			<h3>
				Database Refresh in Progress
			</h3>

			<p>
				The database for this site is currenty under maintenance or
				being restored from the nightly sync. This process takes about
				30 minutes ordinarily. Please come back later.
			</p>

			<p>
				Database recovery started at <% $timestamp %> UTC.
			</p>
		</div>
	</body>
</html>

