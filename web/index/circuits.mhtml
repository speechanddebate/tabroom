<%args>
	$dbh
	$person
	$country => undef
	$state   => undef
	$year    => undef
</%args>
<%init>


	unless ($year) {
		my $year_dt = Tab::school_year;
		$year = $year_dt->year;
	}

	my $end_limit = "$year-07-01 00:00:00";
	my $start_limit = ($year - 1)."-07-01 00:00:00";

	$country =~ s/[\W_]//g;
	$state =~ s/[\W_]//g;

	$country = substr($country, 0, 2);
	$state = substr($state, 0, 2);

	my $limiter;

	if ($country) {
		$limiter .= " and circuit.country = '$country' ";
	}

	if ($state) {
		$limiter .= " and circuit.state = '$state' ";
	}

	my $sth = $dbh->prepare("
		select
			circuit.id, circuit.abbr, circuit.name, circuit.state, circuit.country,
			count(tourn.id) as tourns
		from circuit, tourn_circuit ct, tourn
		where 1=1
			and circuit.active = 1
			and ct.circuit = circuit.id
			and ct.approved = 1
			and ct.tourn = tourn.id
			and tourn.start > ?
			and tourn.start < ?
			and tourn.hidden = 0
		$limiter
		group by circuit.id
		order by circuit.name
	");

	$sth->execute($start_limit, $end_limit);
	my $circuits = $sth->fetchall_hash();

</%init>

	<div class="main">

		<div class='flexrow'>
			<span class="threequarters nospace">
				<h2><% $country %><% $country && $state ? "&ndash;" : "" %><% $state %> Circuits on Tabroom</h2>
			</span>
			<span
				class = "quarter rightalign nospace"
				id    = "circuits_buttonarea"
			>
			</span>
		</div>

		<& "/funclib/tablesorter.mas", table => "circuits" &>

		<table id="circuits">

			<thead>
			<tr class="yellowrow smallish padvert">

				<th>
					Abbr
				</th>

				<th>
					Circuit Name
				</th>

				<th>
					Locale
				</th>

				<th>
					Tournaments
				</th>

				<th>
					Calendar
				</th>

			</tr>
			</thead>
			<tbody>
%			foreach my $circuit (@{$circuits}) {

				<tr class="row">
					<td class="padleft">
						<% $circuit->{abbr} %>
					</td>

					<td class="nospace">
						<a
							class="plain full hover padleft"
							href="circuit/index.mhtml?circuit_id=<% $circuit->{id} %>"
						>
						<% $circuit->{name} %>
						</a>
					</td>

					<td class="centeralign">
						<% $circuit->{state} || $circuit->{country} %><% $circuit->{state} && $circuit->{country} ne "US" ? "/".$circuit->{country} : "" %>
					</td>

					<td class="centeralign">
						<% $circuit->{tourns} %>
					</td>

					<td class="centeralign nospace">
						<a
							class="buttonwhite bluetext thin fa fa-large fa-calendar invert"
							href="circuit/calendar.mhtml?circuit_id=<% $circuit->{id} %>"
						>
						</a>
					</td>
				</tr>
%			}
			</tbody>

		</table>

	</div>

<%perl>

	$sth = $dbh->prepare('
		select distinct circuit.state
		from circuit, tourn, tourn_circuit ct
		where circuit.state is not null
			and circuit.state != ""
			and circuit.active = 1
			and ct.circuit = circuit.id
			and ct.approved = 1
			and ct.tourn = tourn.id
			and tourn.start > ?
			and tourn.start < ?
			and tourn.hidden = 0
		order by circuit.state
	');

	$sth->execute($start_limit, $end_limit);
	my $states = $sth->fetchall_hash();

	my $cth = $dbh->prepare('
		select distinct circuit.country
		from circuit, tourn, tourn_circuit ct
		where circuit.country is not null
			and circuit.country != ""
			and circuit.active = 1
			and ct.circuit = circuit.id
			and ct.approved = 1
			and ct.tourn = tourn.id
			and tourn.start > ?
			and tourn.start < ?
			and tourn.hidden = 0
		order by circuit.country
	');
	$cth->execute($start_limit, $end_limit);
	my $countries = $cth->fetchall_hash();

</%perl>

	<div class="menu">

		<div class="sidenote">

			<h4>Locations</h4>

			<a class="yellow full" href="circuits.mhtml">
				All Locations
			</a>

			<h4>Countries</h4>

%			foreach my $acountry (@{$countries}) {
				<a
					class="<% $acountry->{country} eq $country ? "dk" : "" %>blue third centeralign"
					href="circuits.mhtml?country=<% $acountry->{country} %>"
				> <% $acountry->{country} %> </a>
%			}

			<h4>States/Provinces</h4>

%			foreach my $astate (@{$states}) {
				<a
					class="<% $astate->{state} eq $state ? "dk" : "" %>blue third centeralign"
					href="circuits.mhtml?state=<% $astate->{state} %>"
				> <% $astate->{state} %> </a>
%			}

		</div>

	</div>

	<br style="clear: both;">

