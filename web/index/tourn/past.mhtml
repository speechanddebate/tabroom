<%args>
	$webname => undef
	$dbh
</%args>
<%init>

	my @array = eval {
		return @{$webname};
	};

	if (@array) {
		$webname = $array[0];
	}

	my $sth = $dbh->prepare("
		select tourn.id, tourn.start, tourn.end, tourn.webname, tourn.name
			from tourn
		where webname = ?
			and tourn.end < NOW()
		order by tourn.start
	");

	$sth->execute($webname);
	my $tourns = $sth->fetchall_hash();

</%init>

	<div class="main">

		<h2>
			<% $webname %> Tournaments
		</h2>

		<& /funclib/tablesorter.mas, table => "past_tourns" &>

		<table id="past_tourns">

			<thead>

				<tr class="yellowrow smallish">

					<th>
						Year
					</th>

					<th>
						Name
					</th>

					<th>
						Start
					</th>

					<th>
						End
					</th>

				</tr>

			</thead>

			<tbody>

%				foreach my $tourn (@{$tourns}) {

					<tr>

						<td>
							<% substr($tourn->{start}, 0, 4) %>
						</td>

						<td>
							<a class="plain" href="index.mhtml?tourn_id=<% $tourn->{id} %>">
								<% $tourn->{name} %>
							</a>
						</td>

						<td>
							<& "/funclib/showdate.mas",
								string => $tourn->{start},
								tz     => $tourn->{tz},
								format => "murica"
							&>
						</td>

						<td>
							<& "/funclib/showdate.mas",
								string => $tourn->{end},
								tz     => $tourn->{tz},
								format => "murica"
							&>
						</td>

					</tr>
%				}

			</tbody>

		</table>

	</div>


