<%args>
	$round
	$reset => undef
</%args>
<%init>

	my $dbh = Tab::DBI->db_Main();

	my $sth = $dbh->prepare("
		select
			panel.id, panel.letter
		from panel
			where panel.round = ?
		order by panel.bye DESC, panel.letter, panel.id
	");

	$sth->execute($round);

	my $results = $sth->fetchall_hash();
	my %taken;
	my $last;

	my $update_sth = $dbh->prepare("
		update panel set letter = ? where id = ?
	");

	my $counter = 1;

	foreach my $result (@{$results}) {

		my $letter = $result->{letter};

		if ($reset) {
			$letter = $counter++;
			$update_sth->execute($letter, $result->{id});
		}

		if ($letter > $last) {
			$last = $letter;
		}

		$taken{$letter}{$result->{id}}++;
	}


	foreach my $letter (sort {$a cmp $b} keys %taken) {
		if ((scalar (keys %{$taken{$letter}})) > 2)  {
			foreach my $id (sort {$a <=> $b} keys %{$taken{$letter}}) {
				$last++;
				$update_sth->execute($last, $id);
			}
		}
	}

	return;

</%init>
